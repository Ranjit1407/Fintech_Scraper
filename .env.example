# Copy to .env (git-ignored) and adjust. This file holds secrets and environment switches only;
# models and generation parameters (temperature, max_tokens, ...) are profiles in config/llm.toml.

# --- LLM secrets ------------------------------------------------------------
# Free key: https://openrouter.ai/keys  (free models need no credits)
OPENROUTER_API_KEY=
# Only needed if you switch to these providers:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DASHSCOPE_API_KEY=

# --- LLM selection (optional) ----------------------------------------------
# Profile from config/llm.toml; defaults to its active_profile.
# LLM_PROFILE=ollama-local
# One-off overrides of the chosen profile:
# LLM_PROVIDER=none
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_CONFIG_FILE=config/llm.toml

# --- Database -------------------------------------------------------------
# SQLite works out of the box; use PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/webscraper
DATABASE_URL=sqlite:///./scraper.db

# --- Crawler identity and politeness -------------------------------------
# Identify the bot honestly and give site owners a way to contact you.
USER_AGENT=WebScraperBot/1.0 (+https://your-company.example/bot; bot@your-company.example)
MIN_REQUEST_INTERVAL=2.0
REQUEST_TIMEOUT=20
MAX_RETRIES=3
PLAYWRIGHT_ENABLED=true
# Lets jobs target 127.0.0.1 / private IPs, e.g. the sample site served locally. Keep false when deployed.
ALLOW_PRIVATE_HOSTS=false

# --- Governance -----------------------------------------------------------
PRESIDIO_ENABLED=true
PRESIDIO_SPACY_MODEL=en_core_web_sm
PII_BLOCK_THRESHOLD=25
API_PROBE_ENABLED=true

# --- Validation -----------------------------------------------------------
# Extracted items below this confidence (0-1) are rejected.
MIN_ITEM_CONFIDENCE=0.3

# --- Background jobs ------------------------------------------------------
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# --- API ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
AUDIT_LOG_FILE=logs/audit.log
